<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="ica_book_shop">
            <field name="name">Book Shop</field>
            <field name="description">Book Shop Description</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="ica_book_shop.ica_book_shop"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="ica_book_shop.ica_book_shop"/>
            <field name="implied_ids" eval="[(4, ref('ica_book_shop.group_employee'))]"/>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="ica_book_shop.ica_book_shop"/>
            <field name="implied_ids" eval="[(4, ref('ica_book_shop.group_manager'))]"/>
        </record>

    </data>
</odoo>