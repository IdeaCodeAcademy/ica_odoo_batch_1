<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="Books" invisible="not books_ids">
                    <field name="books_ids">
                        <tree create="0" delete="0">
                            <field name="cover" widget="image"/>
                            <field name="name"/>
                            <field name="release_year"/>
                            <field name="state"/>
                            <field name="category_ids" optional="hide"/>
                        </tree>
                        <form create="0" delete="0" edit="0">
                            <header>
                                <field name="state" widget="statusbar"/>
                            </header>
                            <sheet>
                                <group>
                                    <field name="cover" widget="image" readonly="1"/>
                                    <field name="name"/>
                                    <field name="release_year"/>
                                    <field name="state"/>
                                    <field name="category_ids" widget="many2many_tags"/>
                                </group>
                            </sheet>
                            <!--                            <footer>-->
                            <!--                                <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>-->
                            <!--                            </footer>-->
                        </form>
                    </field>
                </page>
            </notebook>

<!--            <sheet position="inside">-->
                <div class="oe_button_box" name="button_box" position="inside">
                    <button name="action_books" type="object"
                            class="oe_stat_button" icon="fa-book">
                        <div class="o_stat_info">
                            <span class="o_stat_text">
                                Books
                            </span>
                            <field name="book_count" class="o_stat_value"/>
                        </div>
                    </button>
                </div>
<!--            </sheet>-->

        </field>
    </record>
</odoo>