<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ica_books_oder_view_tree" model="ir.ui.view">
        <field name="name">ica_books_view_tree</field>
        <field name="model">ica.books.order</field>
        <field name="arch" type="xml">
            <tree string="ica_books_tree">
                <field name="name"/>
                <field name="partner_id"/>
            </tree>
        </field>
    </record>

    <record id="ica_books_order_view_form" model="ir.ui.view">
        <field name="name">ica_books_order_view_form</field>
        <field name="model">ica.books.order</field>
        <field name="arch" type="xml">
            <form string="ica_books_order_form">
                <sheet>
                    <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                </div>
                    <group>
                        <field name="name" invisible="1"/>
                        <field name="partner_id"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="top">
                            <field name="book_id"/>
                            <field name="author_id"/>
                            <field name="sale_price"/>
                            <field name="currency_id" optional="hide"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ica_books_order_action" model="ir.actions.act_window">
        <field name="name">Book Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ica.books.order</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>