<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="book_order_wizard_view_form" model="ir.ui.view">
        <field name="name">book_order_wizard_view_form</field>
        <field name="model">book.order.wizard</field>
        <field name="arch" type="xml">
            <form string="book_order_wizard_form">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="book_id"/>
                            <field name="author_id"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="sale_price"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_book_order" string="Create Book Order" type="object" class="btn btn-primary"/>
                    <button special="cancel" data-hotkey="x" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="book_order_wizard_action" model="ir.actions.act_window">
        <field name="name">Book Order Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">book.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>